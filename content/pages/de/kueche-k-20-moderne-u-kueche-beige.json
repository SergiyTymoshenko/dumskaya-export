      },
      {
       "t": "p",
       "html": "Insel: Nein"
      },
      {
       "t": "p",
       "html": "Scharniere: Muller ohne Dämpfung"
      },
      {
       "t": "p",
       "html": "Dekor: Einfarbig"
      },
      {
       "t": "p",
       "html": "Auszüge: Teleskopauszüge ohne Dämpfung"
      },
      {
       "t": "p",
       "html": "Seitenlängen der K-20 sowie die Anordnung von Kästen, Arbeitsfläche und Einbaugeräten passen wir an Ihre Küche an."
      }
