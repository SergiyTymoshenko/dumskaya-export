# Настройки заявок и бота студии. Файл на сервере: /home/deploy/dumskaya/lead.env (доступ только у deploy).
# Заполняет мастер настройки: с Mac — npm run leads.
# Telegram-бот студии: токен от @BotFather и Telegram ID разработчика (получает все уведомления).
TELEGRAM_BOT_TOKEN=
BOT_OWNER_ID=633722
BOT_DB=/home/deploy/dumskaya/bot.db
# Почта: Gmail с паролем приложения (Google-аккаунт → Безопасность → Пароли приложений).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dumskaya.design@gmail.com
SMTP_PASSWORD=
MAIL_TO=dumskaya.design@gmail.com
LEADS_FILE=/home/deploy/dumskaya/leads.jsonl
PORT=8095
# Перевод: сообщения заказчиков на русский (бот и письмо), разговоры в кабинетах, названия на языке человека.
# Вписывает мастер: с Mac — npm run translate. Пусто — без перевода. Ключ DeepL (…:fx) или Claude (sk-ant-…) тоже подойдёт.
# Модели ChatGPT (решено 24.10.2026): ключ берётся из файла настроек проекта УЧЕТ на этом сервере (мастер спросит путь).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Кто переводит: openai, deepl или claude (пусто — первый, у кого есть ключ, в этом порядке)
TRANSLATE_PROVIDER=
DEEPL_API_KEY=
ANTHROPIC_API_KEY=
