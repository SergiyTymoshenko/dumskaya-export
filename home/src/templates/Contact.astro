---
import Crumbs from '../components/Crumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import { ui } from '../lib/i18n';
import { site, phones, cityName, type HPage } from '../lib/catalog';
interface Props { page: HPage }
const { page } = Astro.props;
const l = page.lang;
const T = ui(l);
const a = site.contacts.address;
const country = { en: 'Slovakia', ru: 'Словакия', de: 'Slowakei', fr: 'Slovaquie', es: 'Eslovaquia' }[l];
---
<Crumbs items={page.crumbs} />
<div class="contact wrap">
  <div>
    <h1 class="display">{page.h1}</h1>
    <p class="contact__lead">{T.contact_lead}</p>
    <h2 class="section-title">{T.phones}</h2>
    <ul class="contact__list">
      {phones(l).map((p: any) => <li><a href={`tel:${p.tel}`}>{p.text}</a> <span class="muted">{cityName(p, l)}</span></li>)}
    </ul>
    <h2 class="section-title">{T.email}</h2>
    <p><a href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a></p>
    <p>{site.contacts.messengers.map((m: any, i: number) => <>{i > 0 && ' · '}<a href={m.href} rel="noopener">{m.name}</a></>)}</p>
    <h2 class="section-title">{T.address}</h2>
    <address>DUMSKAYA DESIGN<br />{a.street}, {a.postal} {a.city}, {country}<br /><a href={site.contacts.maps} rel="noopener" target="_blank">Google Maps</a></address>
  </div>
  <LeadForm lang={l} id="lead-contact" />
</div>
