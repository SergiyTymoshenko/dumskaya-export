---
// Страницы-подборки: раздел (категории раздела), «Для улицы» и фабрика (товары по категориям), список фабрик.
import Crumbs from '../components/Crumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import Img from '../components/Img.astro';
import { ui } from '../lib/i18n';
import { typo } from '../lib/typo';
import { departments, byCategory, byBrand, outdoorProducts, brandList, brandsInfo, paths, catName, sortProducts, mixByBrand, countryName, type HPage, type Product } from '../lib/catalog';
interface Props { page: HPage }
const { page } = Astro.props;
const l = page.lang;
const T = ui(l);
const order = departments.flatMap((d: any) => d.categories);
const groupBy = (ps: Product[], mix = false) => order.map((c: string) => ({ c, ps: (mix ? mixByBrand : sortProducts)(ps.filter((p) => p.category === c), l) })).filter((g: any) => g.ps.length);
let lead = '';
let groups: { c: string; ps: Product[]; more?: string }[] = [];
let tiles: { href: string; image?: string; title: string; sub: string }[] = [];
if (page.kind === 'dept') {
  const d = departments.find((x: any) => x.id === page.key);
  tiles = d.categories.map((c: string) => ({ href: paths.cat(c)[l], image: byCategory[c].find((p) => p.images[0])?.images[0].name, title: catName(c, l), sub: T.products(byCategory[c].length) }));
} else if (page.kind === 'brands') {
  lead = T.brandsLead;
  tiles = brandList.map((b) => ({ href: paths.brand(b.slug)[l], image: byBrand[b.slug].find((p) => p.images[0])?.images[0].name, title: b.name, sub: T.products(byBrand[b.slug].length) }));
} else if (page.kind === 'outdoor') {
  lead = T.outdoorLead;
  groups = groupBy(outdoorProducts, true).map((g: any) => ({ ...g, more: g.ps.length > 8 ? `${paths.cat(g.c)[l]}?outdoor=1` : undefined, ps: g.ps.slice(0, 8) }));
} else if (page.kind === 'brand') {
  const ps = byBrand[page.key!];
  const ru = l === 'ru' ? brandsInfo[ps[0].factory]?.ru : '';             // по-русски ищут и «Минотти», «Полиформ»
  lead = `${ru ? ru + ' · ' : ''}${countryName(ps[0].factory, l)} · ${T.products(ps.length)}`;
  groups = groupBy(ps).sort((a: any, b: any) => b.ps.length - a.ps.length)        // у фабрики сначала её главное
    .map((g: any) => ({ ...g, more: g.ps.length > 8 ? `${paths.cat(g.c)[l]}?brand=${page.key}` : undefined, ps: g.ps.slice(0, 8) }));
}
const showBrand = page.kind !== 'brand';
---
<Crumbs items={page.crumbs} />
<header class="lhead wrap">
  <h1 class="display">{page.h1}</h1>
  {lead && <p class="muted" data-own>{typo(lead, l)}</p>}
</header>
{tiles.length > 0 && (
  <div class="cats wrap">
    {tiles.map((t, i) => (
      <a class="cat" href={t.href}>
        <span class="cat__img"><Img name={t.image} alt={t.title} sizes="(min-width: 960px) 33vw, 50vw" eager={i < 3} /></span>
        <span class="cat__title">{t.title}</span>
        <span class="cat__sub muted">{t.sub}</span>
      </a>
    ))}
  </div>
)}
{groups.map((g, gi) => (
  <section class="group">
    <h2 class="group__h wrap"><a href={paths.cat(g.c)[l]}>{catName(g.c, l)}</a></h2>
    <div class="grid wrap">{g.ps.map((p, j) => <ProductCard p={p} lang={l} showBrand={showBrand} eager={tiles.length === 0 && gi === 0 && j < 4} />)}</div>
    {g.more && <p class="wrap group__more"><a class="btn" href={g.more}>{T.showAll}</a></p>}
  </section>
))}
