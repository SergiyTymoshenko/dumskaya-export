---
import Base from '../layouts/Base.astro';
import { LANGS, homePath, ui } from '../lib/i18n';
import type { HPage } from '../lib/catalog';
const page: HPage = { kind: 'home', lang: 'en', path: '/404', alt: {}, title: 'Page not found | DUMSKAYA HOME', description: '', h1: 'Page not found', crumbs: [] };
---
<Base page={page} noindex>
  <div class="nf wrap">
    <h1 class="display">{ui('en').notFound}</h1>
    <p>{ui('en').notFoundText}</p>
    <p><a class="btn btn--solid" href="/">{ui('en').home}</a></p>
    {LANGS.filter((l) => l !== 'en').map((l) => <p class="muted" lang={l}>{ui(l).notFound}. <a href={homePath(l)}>{ui(l).home}</a></p>)}
  </div>
</Base>
<style>
  .nf { padding-block: clamp(64px, 12vw, 160px); text-align: center; display: grid; justify-items: center; gap: 8px; }
  .nf h1 { font-size: clamp(24px, 3.4vw, 40px); }
</style>
