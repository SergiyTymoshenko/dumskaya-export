---
// Чертёж (или снимок элемента) с подписью исполнения; по нажатию — крупно.
import Img from './Img.astro';
import { manifest, type Pic } from '../lib/catalog';
interface Props { d: Pic; i: number }
const { d } = Astro.props;
const full = manifest[d.name]?.files.at(-1)?.[1];
---
<button type="button" class="draws__i" data-full={full ? `/img/${full}` : ''}>
  <Img name={d.name} alt={d.title || ''} sizes="(min-width: 960px) 33vw, 50vw" />
  {d.title && <span class="draws__t">{d.title}</span>}
</button>
