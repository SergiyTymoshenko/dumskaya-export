---
// Шапка как у сайта студии: меню слева, логотип по центру, языки и телефон справа.
// Меню — разделы каталога с категориями, «Для улицы», фабрики, контакты.
import { LANGS, LANG_LABEL, HREFLANG, homePath, ui } from '../lib/i18n';
import { departments, outdoorProducts, brandList, paths, catName, phones, cityName, homeEmail, tax, type HPage } from '../lib/catalog';
interface Props { page: HPage }
const { page } = Astro.props;
const l = page.lang;
const T = ui(l);
const tel = phones(l);
const altOf = (x: typeof l) => page.alt[x] || homePath(x);
---
<header class="hdr">
  <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
    <span class="burger" aria-hidden="true"><i></i><i></i></span>
    <span class="hdr__burger-label">{T.menu}</span>
  </button>
  <a class="hdr__logo" href={homePath(l)}><img src="/logo-h.svg" alt="DUMSKAYA HOME" width="200" height="35" /></a>
  <div class="hdr__right">
    <nav class="hdr__langs" aria-label="Language">
      {LANGS.map((x) => x === l
        ? <span aria-current="true" lang={HREFLANG[x]}>{LANG_LABEL[x]}</span>
        : <a href={altOf(x)} hreflang={HREFLANG[x]} lang={HREFLANG[x]}>{LANG_LABEL[x]}</a>)}
    </nav>
    {tel[0] ? (
      <a class="hdr__phone" href={`tel:${tel[0].tel}`} aria-label={`${T.call}: ${tel[0].text}`}>
        <span class="hdr__phone-text" aria-hidden="true">{tel[0].text}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
      </a>
    ) : (
      /* на всех языках, кроме русского, телефона нет — связь через форму */
      <a class="hdr__phone" href={paths.contact[l]} aria-label={T.writeUs}>
        <span class="hdr__phone-text" aria-hidden="true">{T.writeUs}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm0 2.2V17h16V7.2l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z" fill="currentColor"/></svg>
      </a>
    )}
  </div>
</header>

<div class="menu" id="menu" hidden>
  <div class="menu__top">
    <button class="hdr__burger" type="button" data-menu-close>
      <span class="burger burger--x" aria-hidden="true"><i></i><i></i></span>
      <span class="hdr__burger-label">{T.close}</span>
    </button>
    <a class="hdr__logo" href={homePath(l)}><img src="/logo-h.svg" alt="DUMSKAYA HOME" width="200" height="35" /></a>
    <span></span>
  </div>
  <nav class="menu__body" aria-label={T.menu}>
    <p class="menu__langs">
      {LANGS.map((x) => x === l ? <span aria-current="true">{LANG_LABEL[x]}</span> : <a href={altOf(x)} hreflang={HREFLANG[x]} lang={HREFLANG[x]}>{LANG_LABEL[x]}</a>)}
    </p>
    <div class="menu__groups">
      {departments.map((d: any) => (
        <section>
          <h2 class="menu__group"><a href={paths.dept(d)[l]}>{d.name[l]}</a></h2>
          <ul>{d.categories.map((c: string) => <li><a href={paths.cat(c)[l]} aria-current={paths.cat(c)[l] === page.path ? 'page' : undefined}>{catName(c, l)}</a></li>)}</ul>
        </section>
      ))}
      <section>
        {outdoorProducts.length > 0 && <h2 class="menu__group"><a href={paths.outdoor()[l]}>{tax.outdoor.name[l]}</a></h2>}
        <h2 class="menu__group"><a href={paths.brands[l]}>{T.brands}</a></h2>
        <ul>{brandList.map((b) => <li><a href={paths.brand(b.slug)[l]}>{b.name}</a></li>)}</ul>
        <h2 class="menu__group menu__group--gap"><a href={paths.contact[l]}>{T.contact}</a></h2>
      </section>
    </div>
    <div class="menu__foot">
      {tel.length > 0 && <p>{tel.map((p: any) => <span class="menu__phone"><a href={`tel:${p.tel}`}>{p.text}</a> <span class="muted">{cityName(p, l)}</span></span>)}</p>}
      {homeEmail && <p><a href={`mailto:${homeEmail}`}>{homeEmail}</a></p>}
      <p><a href={paths.contact[l]}>{T.writeUs}</a></p>
    </div>
  </nav>
</div>

<script>
  const menu = document.getElementById('menu')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;
  const open = () => { menu.hidden = false; document.documentElement.classList.add('menu-open'); openBtn.setAttribute('aria-expanded', 'true'); closeBtn.focus(); };
  const close = () => { menu.hidden = true; document.documentElement.classList.remove('menu-open'); openBtn.setAttribute('aria-expanded', 'false'); openBtn.focus(); };
  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) close(); });
</script>

<style>
  .hdr, .menu__top {
    position: sticky; top: 0; z-index: 20;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    height: var(--header); padding-inline: var(--pad); background: var(--paper);
  }
  .hdr__burger { justify-self: start; display: inline-flex; align-items: center; gap: 12px; min-height: 44px; min-width: 44px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--ink); }
  .hdr__burger-label { font-size: 13px; letter-spacing: 0.06em; }
  @media (max-width: 719px) { .hdr__burger-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
  .burger { position: relative; width: 26px; height: 12px; }
  .burger i { position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; }
  .burger i:first-child { top: 0; } .burger i:last-child { bottom: 0; }
  .burger--x i:first-child { top: 5px; transform: rotate(45deg); }
  .burger--x i:last-child { bottom: 5px; transform: rotate(-45deg); }
  .hdr__logo { display: block; line-height: 0; }
  .hdr__logo img { display: block; height: 24px; width: auto; }
  @media (min-width: 720px) { .hdr__logo img { height: 32px; } }
  .hdr__right { justify-self: end; display: flex; align-items: center; gap: 20px; }
  .hdr__langs { display: none; gap: 12px; font-size: 13px; letter-spacing: 0.06em; }
  .hdr__langs a { color: var(--stone); text-decoration: none; }
  .hdr__langs a:hover, .hdr__langs [aria-current] { color: var(--ink); }
  @media (min-width: 720px) { .hdr__langs { display: flex; } }
  .hdr__phone { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 44px; height: 44px; margin-right: -12px; padding-right: 12px; color: var(--ink); text-decoration: none; }
  .hdr__phone-text { display: none; font-size: 14px; letter-spacing: 0.04em; white-space: nowrap; }
  @media (min-width: 1100px) { .hdr__phone-text { display: inline; } .hdr__phone { flex-direction: row-reverse; } }

  .menu { position: fixed; inset: 0; z-index: 50; overflow-y: auto; background: var(--paper); }
  .menu__body { padding: clamp(16px, 4vw, 48px) var(--pad) 48px; display: grid; gap: 32px; }
  .menu__groups { display: grid; gap: 32px; }
  @media (min-width: 720px) { .menu__groups { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .menu__groups { grid-template-columns: repeat(4, 1fr); } }
  .menu__group { font-family: var(--display); text-transform: uppercase; letter-spacing: 0.18em; font-size: 13px; margin-bottom: 10px; color: var(--ink); }
  .menu__group a { text-decoration: none; }
  .menu__group--gap { margin-top: 24px; }
  .menu__groups ul { list-style: none; margin: 0 0 18px; padding: 0; }
  .menu__groups li a { display: inline-block; padding-block: 5px; text-decoration: none; }
  .menu__groups a[aria-current] { color: var(--oak); }
  .menu__foot { font-size: 15px; border-top: 1px solid var(--line); padding-top: 24px; display: grid; gap: 8px; }
  .menu__foot p { margin: 0; }
  .menu__phone { display: inline-block; margin-right: 24px; }
  .menu__phone a, .menu__foot p > a { display: inline-block; padding-block: 8px; }
  .menu__langs { display: flex; gap: 4px; letter-spacing: 0.06em; margin: -8px 0 -8px -10px; }
  .menu__langs > * { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; }
  .menu__langs a { color: var(--stone); text-decoration: none; }
  .menu__langs [aria-current] { color: var(--ink); border-bottom: 1px solid var(--ink); }
  :global(html.menu-open) { overflow: hidden; }
</style>
