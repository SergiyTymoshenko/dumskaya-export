---
// Запрос цены. Отправляет на /api/lead того же сервиса, что и сайт студии (заявка уходит в бот студии).
// model — наш артикул (DF-…, DL-…): по нему бот понимает фабрику и партнёра и пишет подсказку дизайнеру.
// Какой сайт прислал заявку, сервис понимает по адресу (Host: dumskaya-home.com).
import { ui, type Lang } from '../lib/i18n';
import { paths, homeEmail } from '../lib/catalog';
interface Props { lang: Lang; model?: string; product?: string; id?: string; title?: string }
const { lang, model = '', product = '', id = 'lead', title } = Astro.props;
const T = ui(lang);
const prefill = product ? `${T.form.about}: ${product}${model ? ` (${model})` : ''}\n` : '';
---
<form class="lead" id={id} action="/api/lead" method="post" data-lead novalidate>
  <h2 class="lead__title">{title || T.form.title}</h2>
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="page" value="" data-page />
  <input type="hidden" name="model" value={model} />
  <div class="lead__hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label class="lead__f"><span>{T.form.name}</span><input type="text" name="name" required autocomplete="name" maxlength="120" /></label>
  <label class="lead__f"><span>{T.form.contact}</span><input type="text" name="contact" required autocomplete="email" maxlength="160" /></label>
  {/* страна доставки — каталог отправляет заказы по всему миру; без неё не посчитать доставку */}
  <label class="lead__f"><span>{T.form.country}</span><input type="text" name="country" autocomplete="country-name" maxlength="100" /></label>
  <label class="lead__f"><span>{T.form.message}</span><textarea name="message" rows="4" maxlength="3000">{prefill}</textarea></label>
  <p class="lead__consent">{T.form.consent} <a href={paths.privacy[lang]}>{T.privacy}</a>.</p>
  <button class="btn btn--solid" type="submit" data-send>{T.form.send}</button>
  <p class="lead__status" role="status" aria-live="polite" data-status></p>
</form>

<script is:inline define:vars={{ msg: { sending: T.form.sending, ok: T.form.ok, fail: homeEmail ? `${T.form.failMail} ${homeEmail}` : T.form.fail, send: T.form.send } }}>
  document.querySelectorAll('form[data-lead]').forEach((form) => {
    if (form.dataset.ready) return;
    form.dataset.ready = '1';
    form.querySelector('[data-page]').value = location.pathname;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('[data-send]'), status = form.querySelector('[data-status]');
      if (!form.reportValidity()) return;
      btn.disabled = true; btn.textContent = msg.sending; status.textContent = '';
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        if (!res.ok) throw new Error(String(res.status));
        form.reset(); status.textContent = msg.ok; status.dataset.state = 'ok';
      } catch (err) {
        status.textContent = msg.fail; status.dataset.state = 'fail';
      } finally {
        btn.disabled = false; btn.textContent = msg.send;
      }
    });
  });
</script>

<style>
  .lead { display: grid; gap: 16px; max-width: 560px; }
  .lead__title { font-family: var(--display); text-transform: uppercase; letter-spacing: 0.16em; font-size: clamp(16px, 1.7vw, 20px); line-height: 1.4; margin-bottom: 4px; }
  .lead__f { display: grid; gap: 6px; font-size: 14px; color: var(--stone); }
  .lead input, .lead textarea { font: 400 16px/1.4 var(--body); color: var(--ink); background: #fff; border: 0; border-bottom: 1px solid var(--ink); border-radius: 0; padding: 10px 0; width: 100%; }
  .lead textarea { resize: vertical; border: 1px solid var(--ink); padding: 10px 12px; }
  .lead input:focus-visible, .lead textarea:focus-visible { outline: 2px solid var(--oak); outline-offset: 2px; }
  .lead__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lead__consent { font-size: 13px; color: var(--stone); margin: 0; }
  .lead button { justify-self: start; }
  .lead__status { margin: 0; min-height: 1.5em; }
  .lead__status[data-state='fail'] { color: #9a3b2e; }
</style>
