---
// Общий каркас страницы DUMSKAYA HOME: те же цвета, шрифты и сетка, что у dumskaya-design.com (src/styles/global.css).
import '../../../src/styles/global.css';
import '../styles/home.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fontDisplayLat from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import fontBodyLat from '@fontsource/commissioner/files/commissioner-latin-400-normal.woff2?url';
import fontDisplayCyr from '@fontsource/montserrat/files/montserrat-cyrillic-400-normal.woff2?url';
import fontBodyCyr from '@fontsource/commissioner/files/commissioner-cyrillic-400-normal.woff2?url';
import { LANGS, HREFLANG, OG_LOCALE, DEFAULT, ui } from '../lib/i18n';
import { manifest, type HPage } from '../lib/catalog';

interface Props { page: HPage; noindex?: boolean; schema?: any[] }
const { page, noindex = false, schema = [] } = Astro.props;
const SITE = 'https://dumskaya-home.com';
const url = (p: string) => SITE + p;
const og = page.image && manifest[page.image];
const ogUrl = og ? `${SITE}/img/${(og.files.find(([w]) => w >= 960) || og.files[og.files.length - 1])[1]}` : undefined;
const crumbsLd = page.crumbs.length ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: page.crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: url(c.href) } : {}) })) }] : [];
const ld = [...crumbsLd, ...schema];
---
<!doctype html>
<html lang={HREFLANG[page.lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {(page.lang === 'ru' ? [fontDisplayCyr, fontBodyCyr] : [fontDisplayLat, fontBodyLat]).map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <title>{page.title}</title>
  {page.description && <meta name="description" content={page.description} />}
  {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={url(page.path)} />}
  {!noindex && LANGS.filter((l) => page.alt[l]).map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={url(page.alt[l]!)} />)}
  {!noindex && page.alt[DEFAULT] && <link rel="alternate" hreflang="x-default" href={url(page.alt[DEFAULT]!)} />}
  <meta property="og:type" content={page.kind === 'product' ? 'product' : 'website'} />
  <meta property="og:site_name" content="DUMSKAYA HOME" />
  <meta property="og:locale" content={OG_LOCALE[page.lang]} />
  <meta property="og:title" content={page.title} />
  {page.description && <meta property="og:description" content={page.description} />}
  <meta property="og:url" content={url(page.path)} />
  {ogUrl && <meta property="og:image" content={ogUrl} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" sizes="96x96" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />
  {!noindex && ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
</head>
<body>
  <a class="skip" href="#main">{ui(page.lang).skip}</a>
  <Header page={page} />
  <main id="main">
    <slot />
  </main>
  <Footer page={page} />
</body>
</html>
