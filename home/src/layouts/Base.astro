---
// Общий каркас страницы DUMSKAYA HOME: те же цвета, шрифты и сетка, что у dumskaya-design.com (src/styles/global.css).
import '../../../src/styles/global.css';
import '../styles/home.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fontDisplayLat from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import fontBodyLat from '@fontsource/commissioner/files/commissioner-latin-400-normal.woff2?url';
import fontDisplayCyr from '@fontsource/montserrat/files/montserrat-cyrillic-400-normal.woff2?url';
import fontBodyCyr from '@fontsource/commissioner/files/commissioner-cyrillic-400-normal.woff2?url';
import { LANGS, HREFLANG, HTML_LANG, OG_LOCALE, DEFAULT, homePath, ui } from '../lib/i18n';
import { manifest, site, phones, homeSite, homeEmail, paths, brandsInfo, type HPage } from '../lib/catalog';

interface Props { page: HPage; noindex?: boolean; schema?: any[] }
const { page, noindex = false, schema = [] } = Astro.props;
const SITE = 'https://dumskaya-home.com';
const url = (p: string) => SITE + p;
const og = page.image && manifest[page.image];
const ogUrl = og ? `${SITE}/img/${(og.files.find(([w]) => w >= 960) || og.files[og.files.length - 1])[1]}` : undefined;
// Разметка Schema.org — как у сайта студии: на каждой странице WebSite, WebPage (у списков — CollectionPage)
// и BreadcrumbList, на главной и в «Контактах» — ещё организация. Product не ставим: без цены (offers) Google считает
// такую разметку ошибкой, а цены на сайте не публикуются.
const ORG = `${SITE}/#org`, WEB = `${SITE}/#website`;
// Товар: страница — ItemPage о конкретном изделии; фабрика — организация со своим сайтом (Entity SEO, граф знаний),
// дизайнер — человек, фото — ImageObject с указанием правообладателя (снимки фабрики). Product не ставим (см. выше).
const pr = page.kind === 'product' ? page.product : undefined;
const bi = pr ? brandsInfo[pr.factory] : undefined;
const BRAND = pr ? `${SITE}/${pr.brand_slug}#brand` : '';
const imgObj = (name: string, alt: string) => {
  const m = manifest[name];
  if (!m) return null;
  const f = m.files.find(([w]) => w >= 960) || m.files[m.files.length - 1];
  return { '@type': 'ImageObject', contentUrl: `${SITE}/img/${f[1]}`, width: f[0], height: Math.round(f[0] * m.height / m.width),
    caption: alt, creditText: pr!.brand, copyrightNotice: `© ${bi?.legal || pr!.brand}`, creator: { '@id': BRAND } };
};
const prImgs = pr ? pr.images.map((im, i) => imgObj(im.name, `${pr.name[page.lang]} — ${pr.brand}, ${ui(page.lang).photo.toLowerCase()} ${i + 1}`)).filter(Boolean) : [];
const productNodes: any[] = pr ? [
  { '@type': 'Organization', '@id': BRAND, name: pr.brand, ...(bi?.legal ? { legalName: bi.legal } : {}), ...(bi?.site ? { url: bi.site, sameAs: [bi.site] } : {}) },
  ...(pr.designer ? [{ '@type': 'Person', '@id': `${SITE}/#designer-${pr.designer.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`, name: pr.designer }] : []),
] : [];
const graph: any[] = [
  { '@type': 'WebSite', '@id': WEB, url: SITE + '/', name: 'DUMSKAYA HOME', inLanguage: HTML_LANG[page.lang], publisher: { '@id': ORG } },
  { '@type': ['dept', 'cat', 'outdoor', 'brand', 'brands'].includes(page.kind) ? 'CollectionPage' : page.kind === 'product' ? 'ItemPage' : 'WebPage', '@id': url(page.path) + '#page',
    url: url(page.path), name: page.h1, inLanguage: HTML_LANG[page.lang], isPartOf: { '@id': WEB },
    ...(page.description ? { description: page.description } : {}),
    ...(pr && prImgs.length ? { primaryImageOfPage: prImgs[0], image: prImgs } : ogUrl ? { primaryImageOfPage: ogUrl } : {}),
    ...(pr ? { about: { '@id': BRAND }, ...(productNodes[1] ? { mentions: { '@id': productNodes[1]['@id'] } } : {}),
      keywords: [pr.brand, pr.model, pr.collection_name, pr.name[page.lang], pr.designer].filter((x, i, a) => x && a.indexOf(x) === i).join(', '),
      publisher: { '@id': ORG } } : {}),
    ...(page.crumbs.length ? { breadcrumb: { '@id': url(page.path) + '#crumbs' } } : {}) },
];
graph.push(...productNodes);
// на остальных страницах — короткая запись о магазине, чтобы publisher и @id организации были на каждой странице
if (page.kind !== 'home' && page.kind !== 'contact') graph.push({ '@type': 'Organization', '@id': ORG, name: 'DUMSKAYA HOME', url: SITE + '/',
  logo: SITE + '/logo.svg', parentOrganization: { '@type': 'Organization', name: 'DUMSKAYA DESIGN', url: 'https://dumskaya-design.com/' } });
if (page.kind === 'home' || page.kind === 'contact') graph.push({
  '@type': 'Organization', '@id': ORG, name: 'DUMSKAYA HOME', url: SITE + '/', logo: SITE + '/logo.svg', ...(homeEmail ? { email: homeEmail } : {}),
  areaServed: 'Worldwide',                          // доставка по всему миру
  parentOrganization: { '@type': 'Organization', name: 'DUMSKAYA DESIGN', url: 'https://dumskaya-design.com/' },
  address: { '@type': 'PostalAddress', streetAddress: site.contacts.address.street, postalCode: site.contacts.address.postal,
    addressLocality: site.contacts.address.city, addressCountry: site.contacts.address.country },
  // телефоны — только на русской версии; на остальных — форма на странице «Контакты»
  contactPoint: phones(page.lang).length
    ? phones(page.lang).map((p: any) => ({ '@type': 'ContactPoint', telephone: p.tel, contactType: 'sales', areaServed: p.key === 'at' ? 'AT' : 'SK' }))
    : [{ '@type': 'ContactPoint', contactType: 'sales', url: url(paths.contact[page.lang]) }],
});
if (page.crumbs.length) graph.push({ '@type': 'BreadcrumbList', '@id': url(page.path) + '#crumbs',
  itemListElement: page.crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: url(c.href) } : {}) })) });
const ld = [{ '@context': 'https://schema.org', '@graph': graph }, ...schema];
const verify = homeSite.verification || {};
---
<!doctype html>
<html lang={HTML_LANG[page.lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {(page.lang === 'ru' ? [fontDisplayCyr, fontBodyCyr] : [fontDisplayLat, fontBodyLat]).map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <title>{page.title}</title>
  {page.description && <meta name="description" content={page.description} />}
  {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={url(page.path)} />}
  {!noindex && LANGS.filter((l) => page.alt[l]).map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={url(page.alt[l]!)} />)}
  {!noindex && page.alt[DEFAULT] && <link rel="alternate" hreflang="x-default" href={url(page.alt[DEFAULT]!)} />}
  <meta property="og:type" content={page.kind === 'product' ? 'product' : 'website'} />
  <meta property="og:site_name" content="DUMSKAYA HOME" />
  <meta property="og:locale" content={OG_LOCALE[page.lang]} />
  <meta property="og:title" content={page.title} />
  {page.description && <meta property="og:description" content={page.description} />}
  <meta property="og:url" content={url(page.path)} />
  {ogUrl && <meta property="og:image" content={ogUrl} />}
  {ogUrl && pr && <meta property="og:image:alt" content={`${pr.name[page.lang]} — ${pr.brand}`} />}
  {pr && <meta property="product:brand" content={pr.brand} />}
  <meta name="twitter:card" content="summary_large_image" />
  {verify.google && <meta name="google-site-verification" content={verify.google} />}
  {verify.yandex && <meta name="yandex-verification" content={verify.yandex} />}
  {verify.bing && <meta name="msvalidate.01" content={verify.bing} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" sizes="96x96" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />
  {!noindex && ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
</head>
<body>
  <a class="skip" href="#main">{ui(page.lang).skip}</a>
  {/* полоса над шапкой на всех страницах: доставка по всему миру — главное, что надо знать покупателю из другой страны */}
  <aside class="topbar" aria-label={ui(page.lang).ship_h}><a href={`${homePath(page.lang)}#delivery`}>{ui(page.lang).ship_bar}</a></aside>
  <Header page={page} />
  <main id="main">
    <slot />
  </main>
  <Footer page={page} />
  <script is:inline>
    // Как на сайте студии: нажатия на телефон, e-mail и мессенджеры и время на странице — в статистику студии
    // (бот, «Графики» → DUMSKAYA HOME). Без cookie; по времени на странице статистика отличает людей от программ.
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]'); if (!a) return;
      var h = a.getAttribute('href') || '';
      var t = /^tel:/i.test(h) ? 'tel' : /^mailto:/i.test(h) ? 'mail' : /\/\/wa\.me\//i.test(h) ? 'whatsapp' : /\/\/t\.me\//i.test(h) ? 'telegram' : '';
      if (!t) return;
      try { navigator.sendBeacon('/api/hit', new Blob([JSON.stringify({ t: t, p: location.pathname })], { type: 'text/plain' })); } catch (err) {}
    }, true);
    (function () {
      var shown = 0, since = document.visibilityState === 'visible' ? Date.now() : 0, sent = 0, acted = 0;
      // было ли хоть одно действие человека (прокрутка, касание, мышь, клавиша) и не управляет ли браузером программа —
      // два флажка к времени на странице, чтобы статистика отличала человека (в том числе через VPN) от программы
      ['scroll', 'pointerdown', 'pointermove', 'touchstart', 'keydown', 'wheel'].forEach(function (n) {
        addEventListener(n, function () { acted = 1; }, { once: true, passive: true, capture: true });
      });
      function send() {
        if (since) { shown += Date.now() - since; since = 0; }
        var s = Math.round(shown / 1000);
        if (s < 1 || s === sent) return;
        sent = s;
        var m = { t: 'time', p: location.pathname, s: s, i: acted };
        if (navigator.webdriver) m.w = 1;
        try { navigator.sendBeacon('/api/hit', new Blob([JSON.stringify(m)], { type: 'text/plain' })); } catch (err) {}
      }
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') send(); else if (!since) since = Date.now();
      });
      addEventListener('pagehide', send);
    })();
  </script>
</body>
</html>
