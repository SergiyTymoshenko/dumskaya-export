{
  "name": "dumskaya-site",
  "private": true,
  "type": "module",
  "scripts": {
    "images": "node scripts/images.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "python3 scripts/check_site.py",
    "deploy": "bash scripts/deploy.sh",
    "deploy:home": "bash scripts/deploy_home.sh",
    "tunnel": "echo 'Сайт: http://localhost:8088  (Ctrl+C — закрыть)'; (sleep 2; command -v open >/dev/null && open http://localhost:8088) & ssh -N -o ExitOnForwardFailure=yes -L 8088:127.0.0.1:8088 ${DEPLOY_HOST:-eurox}",
    "tunnel:home": "bash scripts/tunnel_home.sh",
    "check:ux-home": "node scripts/ux_home.cjs",
    "check:ux-site": "node scripts/ux_site.cjs",
    "check:ux-apps": "node scripts/ux_apps.cjs",
    "check:ux-drag": "node scripts/ux_drag.cjs",
    "leads": "bash scripts/leads.sh",
    "translate": "bash scripts/leads.sh --translate"
  },
  "dependencies": {
    "@fontsource/commissioner": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
