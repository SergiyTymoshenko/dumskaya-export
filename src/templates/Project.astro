---
import HeroImg from '../components/HeroImg.astro';
import Gallery from '../components/Gallery.astro';
import Tile from '../components/Tile.astro';
import Parts from '../components/Parts.astro';
import Crumbs from '../components/Crumbs.astro';
import Img from '../components/Img.astro';
import Video from '../components/Video.astro';
import { ui, type Lang } from '../lib/i18n';
import { projectsFor, splitCaption, localize, allGalleryImages, isServicesSection, productCards, type Page, type Part, type Img as Pic } from '../lib/data';

interface Props { page: Page }
const { page } = Astro.props;
const lang = page.lang as Lang;
const T = ui(lang);

const list = projectsFor(lang);
const idx = list.findIndex((p) => p.href === page.path);
const project = list[idx];
const [name, area] = splitCaption(project?.label || page.h1);
// листы технической документации (галерея с "docs": true) — отдельным блоком после фото,
// под заголовком своей секции («Пример технической документации…»); остальные галереи — общей лентой
const docs: { title: string; images: Pic[] }[] = [];
const docHeads = new Set<unknown>();
const shots: Pic[] = [];
for (const s of page.sections) s.blocks.forEach((b, k) => {
  if (b.type !== 'gallery') return;
  if (!b.docs) { shots.push(...b.images); return; }
  const h = s.blocks.slice(0, k).reverse().find((x) => x.type === 'heading');
  if (h) docHeads.add(h);
  docs.push({ title: h && h.type === 'heading' ? h.text : '', images: b.images });
});
if (!shots.length) docs.length = 0;            // на странице одни чертежи — показываем их как обычную ленту
// видео и карточки товаров — после фото, каждое под заголовком своей секции
const videos: { title: string; id: string; poster?: string }[] = [];
const prods: { title: string; items: string[] }[] = [];
for (const s of page.sections) s.blocks.forEach((b, k) => {
  if (b.type !== 'video' && b.type !== 'products') return;
  const h = s.blocks.slice(0, k).reverse().find((x) => x.type === 'heading');
  const title = h && h.type === 'heading' && h.level > 1 ? h.text : '';
  if (b.type === 'video') videos.push({ title, id: b.youtube, poster: b.poster });
  else prods.push({ title, items: b.items });
});
const images = shots.length ? shots : allGalleryImages(page);
const [hero, ...photos] = images;
// текст проекта по порядку; подзаголовок выводится, только если за ним идёт текст
// (подписи к галереям вроде «Фотографии реализованного объекта» не нужны — фото идут общей лентой)
type Item = { h: string } | { p: Part[] };
const items: Item[] = [];
const blocks = page.sections.filter((s) => !isServicesSection(s)).flatMap((s) => s.blocks);
blocks.forEach((b, k) => {
  if (b.type === 'heading' && b.level > 1 && blocks[k + 1]?.type === 'text' && k > 0 && !(docs.length && docHeads.has(b))) items.push({ h: b.text });
  else if (b.type === 'text') {
    const last = items[items.length - 1];
    if (last && 'p' in last) last.p.push(...b.parts); else items.push({ p: [...b.parts] });
  }
});
// рисунки (планировочное решение и т. п.) — после текста, перед фото; открываются крупно
const figures = blocks.filter((b): b is Extract<typeof b, { type: 'figure' }> => b.type === 'figure');
const services = page.sections.find(isServicesSection);
const serviceLinks = ((services?.blocks.find((b) => b.type === 'cards') as any)?.items || []).filter((c: any) => c.href);

const f = (project as any)?.facts?.[lang] || {};
const facts = [
  [T.facts.object, f.object || name],
  [T.facts.area, f.area || area],
  [T.facts.city, f.city],
  [T.facts.works, f.works],
  [T.facts.status, f.status],
].filter(([, v]) => v);

const next = list.length > 1 ? list[(idx + 1) % list.length] : null;
const prev = list.length > 1 ? list[(idx - 1 + list.length) % list.length] : null;
const portfolio = localize('/proekty-interior-design', lang);
const contact = localize('/contact-studio-interior-design-bratislava-vienna', lang);
const prices = localize('/price-interior-design-bratislava-wien-praha', lang);
const home = lang === 'ru' ? '/' : `/${lang}`;
import Caps from '../components/Caps.astro';
import { typo } from '../lib/typo';
---
<section class="phero">
  <HeroImg id={hero?.id} alt={hero?.alt || name} eager zoom>
    <div class="phero__cap">
      <p class="phero__title display"><Caps text={name} /></p>
      {area && <p class="phero__sub">{area}</p>}
    </div>
  </HeroImg>
</section>

<div class="pbody wrap">
  <aside class="pside">
    <div class="pside__inner">
      <Crumbs items={[{ label: T.home, href: home }, { label: T.projects, href: portfolio }, { label: project?.label || page.h1 }]} />
      <h1 class="pside__h1"><Caps text={page.h1} /></h1>
      <table class="stamp">
        <caption class="stamp__head">DUMSKAYA DESIGN</caption>
        <tbody>
          {facts.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table>
      <div class="pside__btns">
        {contact && <a class="btn btn--solid" href={contact}>{T.consult}</a>}
        {prices && <a class="btn" href={prices}>{T.prices}</a>}
      </div>
    </div>
  </aside>

  <div class="pmain">
    {items.length > 0 && (
      <div class="pmain__text">
        {items.map((it) => ('h' in it ? <h2 class="ph2">{typo(it.h)}</h2> : <Parts parts={it.p} />))}
      </div>
    )}
    {figures.map((fg) => (
      <figure class="pfig" data-zoom>
        <Img id={fg.image.id} alt={fg.image.alt} sizes="(min-width: 960px) 60vw, 100vw" />
        {fg.caption && <figcaption class="pfig__cap">{fg.caption}</figcaption>}
      </figure>
    ))}
    {photos.length > 0 && <Gallery images={photos} class="pgallery" />}
    {videos.map((v) => (
      <section class="pextra">
        {v.title && <h2 class="ph2">{typo(v.title)}</h2>}
        <Video id={v.id} poster={v.poster} title={v.title || page.h1} lang={lang} />
      </section>
    ))}
    {prods.map((p) => (
      <section class="pextra">
        {p.title && <h2 class="ph2">{typo(p.title)}</h2>}
        <div class="tiles tiles--3">
          {productCards(p.items, lang).map((c) => <Tile href={c.href} image={c.image} title={c.title} sub={c.sub} below sizes="(min-width: 960px) 20vw, (min-width: 720px) 50vw, 100vw" />)}
        </div>
      </section>
    ))}
    {docs.map((d) => (
      <section class="pdocs">
        {d.title && <h2 class="ph2">{typo(d.title)}</h2>}
        <Gallery images={d.images} class="pgallery" />
      </section>
    ))}
  </div>
</div>

{(prev || next) && (
  <nav class="pnav" aria-label={T.projects}>
    <div class="tiles">
      {prev && (() => { const [n, a] = splitCaption(prev.label); return <Tile href={prev.href} image={prev.cover} title={n} sub={`${T.prev}${a ? ', ' + a : ''}`} />; })()}
      {next && (() => { const [n, a] = splitCaption(next.label); return <Tile href={next.href} image={next.cover} title={n} sub={`${T.next}${a ? ', ' + a : ''}`} />; })()}
    </div>
    {portfolio && <p class="pnav__all"><a class="btn" href={portfolio}>{T.allProjects}</a></p>}
  </nav>
)}

{serviceLinks.length > 0 && (
  <section class="psvc wrap" aria-labelledby="svc">
    <h2 id="svc" class="psvc__h">{T.services}</h2>
    <ul>{serviceLinks.map((c: any) => <li><a href={c.href}>{c.title}</a></li>)}</ul>
  </section>
)}

<style>
  .phero { position: relative; }
  .phero :global(.himg)::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.5), rgba(0,0,0,0) 50%); pointer-events: none; }
  .phero__cap { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; padding: 0 var(--pad) clamp(16px, 6vh, 64px); text-align: center; color: #fff; pointer-events: none; text-shadow: 0 1px 12px rgba(0,0,0,.3); }
  .phero__title { color: #fff; margin: 0; font-size: clamp(15px, 3.2vw, 40px); letter-spacing: 0.2em; }
  .phero__sub { margin: 8px 0 0; font-size: 14px; letter-spacing: 0.08em; }
  @media (max-width: 719px) { .phero__title { letter-spacing: 0.14em; } .phero__sub { margin-top: 4px; font-size: 13px; } }

  .pbody { display: grid; gap: 40px; padding-block: clamp(32px, 6vw, 88px); }
  @media (min-width: 960px) { .pbody { grid-template-columns: minmax(280px, 4fr) 8fr; gap: clamp(40px, 5vw, 88px); } }
  @media (min-width: 960px) { .pside__inner { position: sticky; top: calc(var(--header) + 24px); } }
  .pside__h1 { font-family: var(--display); text-transform: uppercase; letter-spacing: 0.14em; font-size: clamp(16px, 1.5vw, 20px); line-height: 1.35; margin: 20px 0 28px; }

  /* Штамп как на чертеже: рамка, строки, название студии в шапке */
  .stamp { width: 100%; border-collapse: collapse; border: 1px solid var(--ink); font-size: 14px; line-height: 1.4; }
  .stamp__head { caption-side: top; text-align: left; border: 1px solid var(--ink); border-bottom: 0; padding: 8px 12px; font-family: var(--display); letter-spacing: 0.24em; font-size: 11px; color: var(--ink); }
  .stamp th, .stamp td { border-top: 1px solid var(--ink); padding: 9px 12px; vertical-align: top; text-align: left; }
  .stamp th { width: 36%; font-weight: 400; color: var(--stone); border-right: 1px solid var(--ink); font-size: 13px; }
  .stamp td { color: var(--ink); }
  .pside__btns { display: grid; gap: 10px; margin-top: 28px; }
  @media (min-width: 560px) and (max-width: 959px) { .pside__btns { grid-template-columns: 1fr 1fr; } }

  .pmain__text { margin-bottom: clamp(32px, 5vw, 56px); }
  .pfig { margin: 0 0 clamp(32px, 5vw, 56px); }
  .pfig :global(img) { display: block; width: 100%; height: auto; background: #fff; }
  .pfig__cap { margin-top: 10px; font-size: 13px; letter-spacing: 0.06em; color: var(--stone); }
  .ph2 { font: 500 clamp(17px, 1.5vw, 19px)/1.35 var(--body); color: var(--ink); margin: 1.6em 0 0.6em; max-width: var(--measure); }
  .ph2:first-child { margin-top: 0; }
  .pdocs, .pextra { margin-top: clamp(48px, 7vw, 88px); }
  .pdocs .ph2, .pextra .ph2 { margin-bottom: clamp(16px, 2vw, 24px); }
  @media (max-width: 719px) { :global(.pgallery) { margin-inline: calc(var(--pad) * -1); } }

  .pnav { padding-top: clamp(24px, 4vw, 48px); }
  .pnav__all { text-align: center; margin: 32px 0 0; }
  .psvc { padding-block: clamp(48px, 7vw, 96px); }
  .psvc__h { font-family: var(--display); text-transform: uppercase; letter-spacing: 0.18em; font-size: 13px; margin-bottom: 16px; }
  .psvc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 28px; }
  .psvc li { padding-block: 8px; }
  .psvc a { text-decoration: none; border-bottom: 1px solid var(--line); padding-block: 4px; }
  .psvc a:hover { border-color: var(--oak); }
</style>
