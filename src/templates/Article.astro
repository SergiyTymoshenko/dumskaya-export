---
import Crumbs from '../components/Crumbs.astro';
import Parts from '../components/Parts.astro';
import Img from '../components/Img.astro';
import Tile from '../components/Tile.astro';
import ServiceLinks from '../components/ServiceLinks.astro';
import { ui, type Lang } from '../lib/i18n';
import Caps from '../components/Caps.astro';
import { homePath, allGalleryImages, pagesOfType, firstGallery, servicesCards, localize, isServicesSection, type Page, type Part } from '../lib/data';
import { typo } from '../lib/typo';
interface Props { page: Page }
const { page } = Astro.props;
const lang = page.lang as Lang;
const T = ui(lang);
// текст статьи по порядку: подзаголовки и абзацы; подзаголовки выводятся как H2
type Item = { h: string } | { p: Part[] };
const items: Item[] = [];
for (const s of page.sections) {
  if (isServicesSection(s)) continue;
  for (const b of s.blocks) {
    if (b.type === 'heading' && b.level > 1) items.push({ h: b.text });
    else if (b.type === 'text') {
      const last = items[items.length - 1];
      if (last && 'p' in last) last.p.push(...b.parts); else items.push({ p: [...b.parts] });
    }
  }
}
const images = allGalleryImages(page);
const [lead, ...rest] = images;
const others = pagesOfType('article', lang).filter((p) => p.path !== page.path);
const contact = localize('/contact-studio-interior-design-bratislava-vienna', lang);
// фото между частями текста: делим текст на 2 половины (по подзаголовку ближе к середине), между ними — 2 фото
const weight = (it: Item) => ('p' in it ? it.p.length : 0);
const total = items.reduce((n, it) => n + weight(it), 0);
let half = items.length, acc = 0;
for (let k = 0; k < items.length; k++) {
  if (acc >= total / 2 && 'h' in items[k]) { half = k; break; }
  acc += weight(items[k]);
}
if (half === items.length) half = Math.ceil(items.length / 2);
---
<article>
  <header class="wrap ahead">
    <Crumbs items={[{ label: T.home, href: homePath(lang) }, { label: T.tips }, { label: page.h1 }]} />
    <h1 class="display ahead__h1"><Caps text={page.h1} /></h1>
  </header>
  {lead && <div class="alead"><Img id={lead.id} alt={lead.alt} sizes="100vw" eager /></div>}
  <div class="wrap abody">
    {items.slice(0, half).map((it) => ('h' in it ? <h2 class="ah2">{typo(it.h)}</h2> : <Parts parts={it.p} />))}
    {rest.length > 1 && (
      <div class="apair">{rest.slice(0, 2).map((i) => <Img id={i.id} alt={i.alt} sizes="(min-width: 720px) 33vw, 100vw" />)}</div>
    )}
    {items.slice(half).map((it) => ('h' in it ? <h2 class="ah2">{typo(it.h)}</h2> : <Parts parts={it.p} />))}
    {contact && <p><a class="btn btn--solid" href={contact}>{T.consult}</a></p>}
  </div>
  {rest.length > 2 && (
    <div class="agal">{rest.slice(2).map((i) => <Img id={i.id} alt={i.alt} sizes="(min-width: 720px) 50vw, 100vw" />)}</div>
  )}
</article>
{others.length > 0 && (
  <section class="aother" aria-labelledby="ot">
    <h2 id="ot" class="section-title wrap aother__h">{T.otherTips}</h2>
    <div class="tiles tiles--3">
      {others.map((o) => <Tile href={o.path} image={firstGallery(o)[0]?.id} alt={firstGallery(o)[0]?.alt} title={o.h1} sizes="(min-width: 960px) 33vw, 50vw" below />)}
    </div>
  </section>
)}
<ServiceLinks items={servicesCards(page)} lang={lang} />
<style>
  .ahead { padding-block: 20px clamp(24px, 4vw, 40px); }
  .ahead__h1 { font-size: clamp(20px, 2.4vw, 30px); max-width: 28em; margin-top: clamp(24px, 4vw, 48px); }
  .ah2 { font: 500 clamp(18px, 1.6vw, 21px)/1.35 var(--body); color: var(--ink); margin: 1.8em 0 0.7em; }
  .ah2:first-child { margin-top: 0; }
  .alead :global(img) { width: 100%; max-height: 78svh; object-fit: cover; }
  .abody { max-width: calc(var(--measure) + 2 * var(--pad)); margin-inline: auto; padding-block: clamp(32px, 5vw, 64px); }
  .apair { display: grid; gap: var(--gap); grid-template-columns: 1fr 1fr; margin: 32px calc(var(--pad) * -1); }
  @media (min-width: 960px) { .apair { margin-inline: -12vw; } }
  .apair :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .agal { display: grid; gap: var(--gap); grid-template-columns: 1fr 1fr; }
  .agal :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 719px) { .agal { grid-template-columns: 1fr; } }
  .aother { padding-top: clamp(48px, 7vw, 96px); }
  .aother__h { padding-bottom: 24px; }
  .aother :global(.tile__title) { font-size: clamp(11px, 0.9vw, 13px); }
  @media (max-width: 719px) { .aother .tiles--3 { grid-template-columns: 1fr; } }
</style>
