---
import Img from '../components/Img.astro';
import HeroImg from '../components/HeroImg.astro';
import Tile from '../components/Tile.astro';
import Parts from '../components/Parts.astro';
import Caps from '../components/Caps.astro';
import Blocks from '../components/Blocks.astro';
import { ui, type Lang } from '../lib/i18n';
import { projectsFor, splitCaption, localize, isServicesSection, site, pagePhones, type Page, type Part } from '../lib/data';
import home from '../../content/home.json';

interface Props { page: Page }
const { page } = Astro.props;
const lang = page.lang as Lang;
const T = ui(lang);

// Дополнительные разделы главной (как мы работаем, цены, FAQ…) — секции с id «home-…»: выводятся общими блоками
const extra = page.sections.filter((s) => (s.id || '').startsWith('home-'));
const own = page.sections.filter((s) => !(s.id || '').startsWith('home-'));
// Текст главной: письмо Ирины и список «что вы получите» — текст в секции с H1
const h1Section = own.find((s) => s.blocks.some((b) => b.type === 'heading' && b.level === 1));
const textBlock = ((h1Section?.blocks.find((b) => b.type === 'text') as any)?.parts as Part[])
  || own.flatMap((s) => s.blocks).filter((b) => b.type === 'text').map((b: any) => b.parts as Part[]).sort((a, b) => b.length - a.length)[0] || [];
const plain = (h: string) => h.replace(/<[^>]+>/g, '');
const qIdx = textBlock.findIndex((p) => p.t === 'p' && /\?\s*$/.test(plain(p.html)));
const letter = qIdx > 0 ? textBlock.slice(0, qIdx) : textBlock;
const benefitsTitle = qIdx > 0 ? plain((textBlock[qIdx] as any).html) : '';
const rest = qIdx > 0 ? textBlock.slice(qIdx + 1) : [];
type Benefit = { title: string; items: string[] };
const benefits: Benefit[] = [];
let closing: Part[] = [];
for (const p of rest) {
  if (p.t === 'p' && /^\s*\d+\.\s*/.test(plain(p.html))) benefits.push({ title: plain(p.html).replace(/^\s*\d+\.\s*/, '').replace(/:\s*$/, ''), items: [] });
  else if (p.t !== 'p' && benefits.length) benefits[benefits.length - 1].items.push(...p.items);
  else closing.push(p);
}
// письмо: первые абзацы видны, остальное раскрывается
const lead = letter.slice(0, 3);
const more = letter.slice(3);

const buttons = (own.flatMap((s) => s.blocks).find((b) => b.type === 'buttons') as any)?.items || [];
const services = page.sections.find(isServicesSection);
const servicesCards = (services?.blocks.find((b) => b.type === 'cards') as any)?.items || [];
const all = projectsFor(lang);
const featured = (home.featured as string[]).map((p) => all.find((x) => x.path === p)).filter(Boolean) as typeof all;
const portfolio = localize('/proekty-interior-design', lang);
const contact = localize('/contact-studio-interior-design-bratislava-vienna', lang);
const prices = localize('/price-interior-design-bratislava-wien-praha', lang);
const heroTitle = page.h1;
---
<section class="hero">
  <HeroImg id={home.hero} alt={heroTitle} eager>
    <div class="hero__cap">
      <h1 class="hero__title display"><Caps text={heroTitle} /></h1>
      <p class="hero__city">{T.heroSub}</p>
      {contact && <a class="btn hero__btn" href={contact}>{T.heroCta}</a>}
    </div>
  </HeroImg>
  {contact && <p class="hero__below wrap"><a class="btn btn--solid" href={contact}>{T.heroCta}</a></p>}
</section>

<section class="studio section wrap" aria-labelledby="about">
  <figure class="studio__photo">
    <Img id={home.portrait} alt={T.portrait} sizes="(min-width: 960px) 34vw, 100vw" />
  </figure>
  <div class="studio__text">
    <h2 id="about" class="section-title">{T.about}</h2>
    <Parts parts={lead} />
    {more.length > 0 && (
      <details class="studio__more">
        <summary>{T.readMore}</summary>
        <Parts parts={more} />
      </details>
    )}
    <div class="studio__btns">
      {contact && <a class="btn btn--solid" href={contact}>{T.consult}</a>}
      {prices && <a class="btn" href={prices}>{T.prices}</a>}
    </div>
  </div>
</section>

<section aria-labelledby="projects">
  <div class="head wrap">
    <h2 id="projects" class="section-title">{T.projects}</h2>
    {portfolio && <a class="head__link" href={portfolio}>{T.allProjects}</a>}
  </div>
  <div class="tiles">
    {featured.map((p) => {
      const [name, area] = splitCaption(p.label);
      return <Tile href={p.href} image={p.cover} title={name} sub={area} />;
    })}
  </div>
</section>

{benefits.length > 0 && (
  <section class="benefits section wrap" aria-labelledby="benefits">
    <h2 id="benefits" class="section-title benefits__title">{benefitsTitle}</h2>
    <div class="benefits__grid">
      {benefits.map((b) => (
        <div class="benefit">
          <h3 class="benefit__title">{b.title}</h3>
          <ul>{b.items.map((i) => <li set:html={i} />)}</ul>
        </div>
      ))}
    </div>
    {closing.length > 0 && <Parts parts={closing} class="benefits__closing" />}
  </section>
)}

{extra.length > 0 && <div class="extra"><Blocks sections={extra} lang={lang} skipH1 /></div>}

{servicesCards.length > 0 && (
  <section aria-labelledby="services" class="services">
    <div class="head wrap">
      <h2 id="services" class="section-title">{T.services}</h2>
    </div>
    <div class="tiles tiles--3">
      {servicesCards.map((c: any) => <Tile href={c.href} image={c.image?.id} alt={c.image?.alt} title={c.title} sizes="(min-width: 960px) 33vw, 50vw" />)}
    </div>
  </section>
)}

<section class="cta section wrap">
  <h2 class="cta__title display">{T.freeConsult}</h2>
  <ul class="cta__phones">
    {pagePhones(page).map((p: any) => <li><a href={`tel:${p.tel}`}>{p.text}</a> <span class="muted">{p.city[lang]}</span></li>)}
  </ul>
  <div class="cta__btns">
    {buttons.slice(0, 2).map((b: any, i: number) => b.href && <a class:list={['btn', i === 0 && 'btn--solid']} href={b.href}>{b.text}</a>)}
  </div>
</section>

<style>
  .hero { position: relative; }
  .hero :global(.himg)::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.62) 0%, rgba(0,0,0,.28) 32%, rgba(0,0,0,0) 60%); pointer-events: none; }
  .hero__cap { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; padding: 0 var(--pad) clamp(20px, 6vh, 64px); color: #fff; text-align: center; text-shadow: 0 1px 14px rgba(0,0,0,.35); }
  .hero__title { color: #fff; font: 400 clamp(13px, 2vw, 26px)/1.5 var(--caption); letter-spacing: 0.24em; padding-left: 0.24em; max-width: 34ch; margin: 0 auto; }
  .hero__city { margin: 10px 0 0; font-size: 14px; letter-spacing: 0.08em; }
  .hero__btn { margin-top: 22px; color: #fff; border-color: rgba(255,255,255,.85); text-shadow: none; backdrop-filter: blur(2px); background: rgba(0,0,0,.12); }
  .hero__btn:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .hero__below { display: none; margin: 0; padding-top: 20px; text-align: center; }
  /* узкие экраны (телефон): фото невысокое — на нём только заголовок, кнопка под фото */
  @media (max-width: 719px), (max-aspect-ratio: 1/1) {
    .hero__btn { display: none; }
    .hero__below { display: block; }
    .hero__title { letter-spacing: 0.16em; padding-left: 0.16em; }
    .hero__city { font-size: 13px; margin-top: 6px; }
  }

  .studio { display: grid; gap: clamp(28px, 5vw, 80px); align-items: start; }
  @media (min-width: 960px) { .studio { grid-template-columns: 5fr 7fr; } }
  .studio__photo { margin: 0; }
  /* на телефоне сначала текст и кнопки, портрет — после */
  @media (max-width: 959px) { .studio__photo { order: 2; max-width: 420px; } }
  .studio__photo :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .studio__text .section-title { margin-bottom: 24px; }
  .studio__more summary { cursor: pointer; display: inline-block; margin-bottom: 1em; color: var(--ink); text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .studio__more summary::-webkit-details-marker { display: none; }
  .studio__more[open] summary { display: none; }
  .studio__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }

  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-block: 0 24px; }
  .head__link { font-size: 15px; white-space: nowrap; }
  .services { padding-top: clamp(48px, 8vw, 112px); }
  .benefits + .services { padding-top: 0; }
  .extra { padding-block: 0 clamp(16px, 3vw, 40px); }
  .extra :global(.blk__text), .extra :global(.blk__h3) { max-width: calc(var(--measure) + 2 * var(--pad)); }

  .benefits__title { max-width: 32em; margin-bottom: clamp(28px, 4vw, 48px); }
  .benefits__grid { display: grid; gap: 32px 48px; border-top: 1px solid var(--line); padding-top: 32px; }
  @media (min-width: 720px) { .benefits__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .benefits__grid { grid-template-columns: repeat(3, 1fr); } }
  .benefit__title { font: 500 17px/1.3 var(--body); color: var(--ink); margin-bottom: 10px; }
  .benefit ul { margin: 0; padding-left: 1.1em; color: var(--text); }
  .benefit li { margin-bottom: 4px; }
  :global(.benefits__closing) { margin-top: 40px; }

  .cta { text-align: center; display: grid; justify-items: center; gap: 28px; border-top: 1px solid var(--line); }
  .cta__title { margin: 0; font: 400 clamp(16px, 1.7vw, 22px)/1.5 var(--caption); letter-spacing: 0.24em; padding-left: 0.24em; max-width: 34ch; }
  .cta__phones { list-style: none; margin: -16px 0 -8px; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0 28px; font-size: 17px; }
  .cta__phones a { display: inline-block; padding-block: 8px; text-decoration: none; color: var(--ink); }
  .cta__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
</style>
