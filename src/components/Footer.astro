---
import { ui, LANGS, LANG_LABEL, HREFLANG, type Lang } from '../lib/i18n';
import { site, type Page, altPath, localize, pagePhones } from '../lib/data';

interface Props { page: Page }
const { page } = Astro.props;
const lang = page.lang as Lang;
const T = ui(lang);
const contact = localize('/contact-studio-interior-design-bratislava-vienna', lang);
const year = new Date().getFullYear();
---
<footer class="ftr wrap">
  <div class="ftr__brand">
    <a class="ftr__logo" href={lang === 'ru' ? '/' : `/${lang}`}><img src="/logo.svg" alt="DUMSKAYA DESIGN — studio interior" width="150" height="89" loading="lazy" /></a>
    <p class="muted">{T.city}</p>
  </div>
  <div class="ftr__contacts">
    <h2 class="visually-hidden">{T.contacts}</h2>
    <ul>
      {pagePhones(page).map((p) => (
        <li><a href={`tel:${p.tel}`}>{p.text}</a> <span class="muted">{p.city[lang]}</span></li>
      ))}
      <li><a href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a></li>
      {contact && <li><a href={contact}>{T.allContacts}</a></li>}
    </ul>
    <address class="ftr__addr">
      <span>DUMSKAYA DESIGN</span>
      {site.contacts.maps
        ? <a href={site.contacts.maps} rel="noopener" target="_blank">{site.contacts.address.label[lang]}</a>
        : <span>{site.contacts.address.label[lang]}</span>}
    </address>
  </div>
  <div class="ftr__aside">
    <ul class="ftr__social">
      {site.contacts.social.map((s: any) => <li><a href={s.href} rel="noopener" target="_blank">{s.name}</a></li>)}
    </ul>
    <p class="ftr__langs">
      {LANGS.map((l) => l === lang
        ? <span aria-current="true">{LANG_LABEL[l]}</span>
        : <a href={altPath(page, l)} hreflang={HREFLANG[l]}>{LANG_LABEL[l]}</a>)}
    </p>
  </div>
  <p class="ftr__copy muted">© {year} DUMSKAYA DESIGN. {T.rights}. <a href={localize('/privacy', lang) || '/privacy'}>{T.form.privacy}</a> · <a href={localize('/image-license', lang) || '/image-license'}>{T.imageLicense}</a><button type="button" class="ftr__cookie" data-cookie-settings hidden>{T.cookieSettings}</button></p>
</footer>

<style>
  .ftr {
    display: grid; gap: 32px; padding-block: 56px 32px;
    border-top: 1px solid var(--line); font-size: 15px;
  }
  @media (min-width: 960px) { .ftr { grid-template-columns: 1fr 1.4fr 1fr; } }
  .ftr p { margin: 0; }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .ftr a { text-decoration: none; }
  .ftr li > a, .ftr__social a, .ftr__langs > * { display: inline-block; padding-block: 10px; }
  .ftr__langs > * { min-width: 32px; }
  .ftr a:hover { text-decoration: underline; }
  .ftr__logo { display: inline-block; line-height: 0; margin-bottom: 14px; }
  .ftr__logo img { width: 150px; height: auto; }
  .ftr__contacts { display: grid; gap: 20px; align-content: start; justify-items: start; }
  .ftr__contacts .btn:hover { text-decoration: none; }
  .ftr__addr { font-style: normal; display: grid; gap: 2px; }
  .ftr__addr a { display: inline-block; padding-block: 6px; }
  .ftr__aside { display: grid; gap: 20px; align-content: start; }
  .ftr__social { grid-auto-flow: column; justify-content: start; gap: 20px !important; }
  .ftr__langs { display: flex; gap: 8px; letter-spacing: 0.06em; }
  .ftr__langs a { color: var(--stone); }
  .ftr__copy { grid-column: 1 / -1; font-size: 13px; }
  .ftr__copy a, .ftr__cookie { display: inline-block; padding-block: 10px; }
  .ftr__cookie { margin-left: 16px; border: 0; background: none; padding-inline: 0; font-size: 13px; color: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: .2em; }
</style>
