---
// Общий вывод блоков страницы: заголовки, текст, фото, карточки, кнопки.
// На странице остаётся ровно один H1 (если шаблон выводит свой — skipH1).
import Gallery from './Gallery.astro';
import Img from './Img.astro';
import Tile from './Tile.astro';
import Parts from './Parts.astro';
import { splitCaption, pageByPath, productCards, type Section, type Phone } from '../lib/data';
import { typo } from '../lib/typo';
import Caps from './Caps.astro';
import LeadForm from './LeadForm.astro';
import Video from './Video.astro';
import type { Lang } from '../lib/i18n';

// phone — телефон региона посадочной страницы: выводится сразу под H1, чтобы был виден на любом экране
interface Props { sections: Section[]; skipH1?: boolean; lang?: Lang; phone?: Phone }
const { sections, skipH1 = false, lang = 'ru', phone } = Astro.props;
let formN = 0;
// Уровни заголовков без пропусков: подзаголовок, встретившийся до первого H2, выводится как H2
// (выглядит так же, как H3), чтобы после H1 не шёл сразу H3.
let seenH2 = false;
// Карточки моделей кухонь: подпись «K-09» и описание из заголовка страницы, порядок — по номеру модели.
const kitchenNo = (href: string | null) => {
  const p = href ? pageByPath.get(href) : null;
  if (!p || p.type !== 'kitchen') return null;
  const n = (p.alternates.ru || p.path).match(/k-?(\d{2})/i)?.[1];
  if (!n) return null;
  const d = p.title.split('|')[0].split(':').slice(1).join(':').trim();
  return { n: Number(n), title: `K-${n}`, sub: d ? d[0].toUpperCase() + d.slice(1) : '' };
};
// Основная (чёрная) кнопка — заявка/консультация, если она есть в наборе; иначе первая.
const isLeadBtn = (x: { text: string; href: string | null }) =>
  !!x.href && (/contact|kontakt|#lead/i.test(x.href) || /консультац|consultation|заявк|замов.*консультац/i.test(x.text));
---
{sections.map((s) => (
  <section class="blk">
    {s.blocks.map((b, k) => {
      if (b.type === 'heading') {
        if (b.level === 1) return skipH1 ? null : (
          <>
            <h1 class:list={['blk__h1 display wrap', phone && 'blk__h1--ph']}><Caps text={b.text} /></h1>
            {phone && (
              <p class="wrap regph">
                <span class="regph__label">{phone.label[lang]}</span>
                <a class="regph__num" href={`tel:${phone.tel}`}>{phone.text}</a>
              </p>
            )}
          </>
        );
        if (b.level >= 3) return seenH2 ? <h3 class="blk__h3 wrap">{typo(b.text)}</h3> : <h2 class="blk__h3 wrap">{typo(b.text)}</h2>;
        seenH2 = true;
        return <h2 class="section-title blk__h wrap"><Caps text={b.text} /></h2>;
      }
      if (b.type === 'text') return <div class="wrap blk__text"><Parts parts={b.parts} /></div>;
      if (b.type === 'gallery') return <Gallery images={b.images} start="pair" class="blk__gallery" sizes="100vw" />;
      if (b.type === 'video') {
        const h = s.blocks.slice(0, k).reverse().find((x) => x.type === 'heading') as any;
        return <div class="wrap blk__video"><Video id={b.youtube} poster={b.poster} title={h?.text || 'YouTube'} lang={lang} /></div>;
      }
      if (b.type === 'products') return (
        <div class="wrap blk__products tiles tiles--3">
          {productCards(b.items, lang).map((c) => <Tile href={c.href} image={c.image} title={c.title} sub={c.sub} below sizes="(min-width: 960px) 33vw, (min-width: 720px) 50vw, 100vw" />)}
        </div>
      );
      if (b.type === 'figure') return (
        <figure class="wrap blk__fig" data-zoom>
          <Img id={b.image.id} alt={b.image.alt} sizes="100vw" />
          {b.caption && <figcaption class="blk__figcap">{b.caption}</figcaption>}
        </figure>
      );
      if (b.type === 'cards') {
        const three = b.items.length >= 6;
        const kit = b.items.map((c) => kitchenNo(c.href));
        const items = kit.every(Boolean)
          ? b.items.map((c, i) => ({ c, k: kit[i]! })).sort((x, y) => x.k.n - y.k.n)
          : b.items.map((c) => ({ c, k: null }));
        return (
          <div class:list={['tiles', three && 'tiles--3']}>
            {items.map(({ c, k }) => {
              const [name, area] = k ? [k.title, k.sub] : splitCaption(c.title);
              return <Tile href={c.href} image={c.image?.id} alt={c.image?.alt || (k ? `${k.title} ${k.sub}` : '')} title={name} sub={area} sizes={three ? '(min-width: 960px) 33vw, 50vw' : '(min-width: 720px) 50vw, 100vw'} />;
            })}
          </div>
        );
      }
      if (b.type === 'buttons') {
        const items = b.items.filter((x) => x.href);
        const main = Math.max(0, items.findIndex(isLeadBtn));
        return (
          <div class="wrap blk__btns">
            {items.map((x, i) => <a class:list={['btn', i === main && 'btn--solid']} href={x.href}>{x.text}</a>)}
          </div>
        );
      }
      if (b.type === 'faq') return (
        <div class="wrap blk__faq">
          {b.items.map((f) => (
            <details class="faq">
              <summary class="faq__q"><h3 class="faq__h">{f.q}</h3></summary>
              <div class="faq__a prose" set:html={f.a} />
            </details>
          ))}
        </div>
      );
      if (b.type === 'facts') return (
        <div class="wrap blk__facts">
          <table class="stamp">
            {b.title && <caption class="stamp__head">{b.title}</caption>}
            <tbody>{b.rows.map(([k, v]) => <tr><th scope="row">{k}</th><td set:html={v} /></tr>)}</tbody>
          </table>
        </div>
      );
      if (b.type === 'form') return <div class="wrap blk__form"><LeadForm lang={lang} id={`lead${formN++ ? formN : ''}`} title={(b as any).title} intro={(b as any).text} /></div>;
      return null;
    })}
  </section>
))}

<style>
  .blk { padding-block: clamp(16px, 3vw, 40px); }
  .blk__h1 { font-size: clamp(20px, 2.4vw, 30px); margin-block: 8px 24px; max-width: 30em; }
  .blk__h1--ph { margin-bottom: 14px; }
  .regph { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; margin: 0 0 28px; }
  .regph__label { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--stone); }
  .regph__num { font: 300 clamp(20px, 2.1vw, 26px)/1.25 var(--display); letter-spacing: 0.04em; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .regph__num:hover { color: var(--oak); }
  .blk__h { margin-block: 24px 20px; max-width: 34em; }
  .blk__text { margin-block: 8px 24px; }
  .blk__video { margin-block: 16px 32px; max-width: 1200px; }
  .blk__products { margin-block: 16px 32px; }
  .blk :global(.blk__gallery) { margin-block: 16px; }
  .blk__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-block: 16px; }
  .blk__h3 { font: 500 17px/1.4 var(--body); color: var(--ink); margin: 28px 0 10px; max-width: var(--measure); }
  .blk__faq { margin-block: 8px 24px; max-width: calc(var(--measure) + 2 * var(--pad)); }
  .faq { border-top: 1px solid var(--line); }
  .faq:last-child { border-bottom: 1px solid var(--line); }
  .faq__q { cursor: pointer; list-style: none; padding: 16px 36px 16px 0; position: relative; font-weight: 500; color: var(--ink); }
  .faq__q::-webkit-details-marker { display: none; }
  /* вопрос — заголовок (для поисковиков и ИИ-ассистентов), выглядит как обычная строка FAQ */
  .faq__h { margin: 0; font: inherit; color: inherit; letter-spacing: inherit; text-transform: none; }
  .faq__q::after { content: '+'; position: absolute; right: 4px; top: 12px; font-size: 22px; font-weight: 300; color: var(--stone); }
  .faq[open] .faq__q::after { content: '–'; }
  .faq__a { padding: 0 0 18px; }
  .faq__a :global(p:last-child) { margin-bottom: 0; }
  .blk__facts { margin-block: 8px 28px; max-width: 640px; }
  .blk__fig { margin-block: 8px 28px; }
  .blk__fig :global(img) { display: block; width: 100%; height: auto; }
  .blk__figcap { margin-top: 10px; font-size: 13px; color: var(--stone); }
  .stamp { width: 100%; border-collapse: collapse; border: 1px solid var(--ink); font-size: 14px; line-height: 1.4; }
  .stamp__head { caption-side: top; text-align: left; border: 1px solid var(--ink); border-bottom: 0; padding: 8px 12px; font-family: var(--display); letter-spacing: 0.2em; text-transform: uppercase; font-size: 11px; color: var(--ink); }
  .stamp th, .stamp td { border-top: 1px solid var(--ink); padding: 9px 12px; vertical-align: top; text-align: left; }
  .stamp th { width: 38%; font-weight: 400; color: var(--stone); border-right: 1px solid var(--ink); font-size: 13px; }
  .stamp td { color: var(--ink); }
  .blk__form { margin-block: 16px 24px; max-width: 640px; }
</style>
