---
import { LANGS, LANG_LABEL, HREFLANG, ui, type Lang } from '../lib/i18n';
import { site, type Page, altPath, localize, phoneFor, pagePhones, homeCatalog } from '../lib/data';

interface Props { page: Page }
const { page } = Astro.props;
const lang = page.lang as Lang;
const T = ui(lang);
const menu = site.menu[lang] as any[];
const priceOverview = localize('/price-interior-design-bratislava-wien-praha', lang);
const home = lang === 'ru' ? '/' : `/${lang}`;
// на посадочных страницах регионов (Вена, Украина, США…) — телефон этого региона
const { phone } = phoneFor(page);
// в меню — Братислава и Вена (на посадочной региона — ещё его телефон); все страны — на странице «Контакты»
const menuPhones = pagePhones(page);
const catalog = homeCatalog(lang);
// каталог фабрик DUMSKAYA HOME — отдельный сайт, пункт сразу за «Магазином»; украинская версия ведёт на русский каталог
// (решено 25.10.2026); пока каталог не открыт на домене, пункта нет (content/site.json → home_catalog.enabled)
const mainItems: any[] = menu.filter((m) => !m.children);
if (catalog) {
  const shop = mainItems.findIndex((m) => /\/(shop|obchod)$/.test(m.href || ''));
  mainItems.splice(shop >= 0 ? shop + 1 : mainItems.length, 0, { href: catalog, label: T.catalogMenu, catalog: true });
}
---
<header class="hdr">
  <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-open>
    <span class="burger" aria-hidden="true"><i></i><i></i></span>
    <span class="hdr__burger-label">{T.menu}</span>
  </button>

  <a class="hdr__logo" href={home}><img src="/logo-h.svg" alt="DUMSKAYA DESIGN" width="208" height="34" /></a>

  <div class="hdr__right">
    <nav class="hdr__langs" aria-label="Language">
      {LANGS.map((l) => (
        l === lang
          ? <span aria-current="true" lang={HREFLANG[l]}>{LANG_LABEL[l]}</span>
          : <a href={altPath(page, l)} hreflang={HREFLANG[l]} lang={HREFLANG[l]}>{LANG_LABEL[l]}</a>
      ))}
    </nav>
    <a class="hdr__phone" href={`tel:${phone.tel}`} aria-label={`${T.call}: ${phone.text}`}>
      <span class="hdr__phone-text" aria-hidden="true">{phone.text}</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
    </a>
  </div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label={T.menu} hidden>
  <div class="menu__top">
    <button class="hdr__burger" type="button" data-menu-close>
      <span class="burger burger--x" aria-hidden="true"><i></i><i></i></span>
      <span class="hdr__burger-label">{T.close}</span>
    </button>
    <a class="hdr__logo" href={home}><img src="/logo-h.svg" alt="DUMSKAYA DESIGN" width="208" height="34" /></a>
    <span></span>
  </div>
  <nav class="menu__body" aria-label={T.menu}>
    <p class="menu__langs menu__langs--top">
      {LANGS.map((l) => l === lang
        ? <span aria-current="true">{LANG_LABEL[l]}</span>
        : <a href={altPath(page, l)} hreflang={HREFLANG[l]} lang={HREFLANG[l]}>{LANG_LABEL[l]}</a>)}
    </p>
    <ul class="menu__main">
      {mainItems.map((m) => m.catalog
        ? <li><a class="display" href={m.href} hreflang={lang === 'ua' ? 'ru' : undefined}>{m.label}</a></li>
        : <li><a class="display" href={m.href} aria-current={m.href === page.path ? 'page' : undefined}>{m.label}</a></li>)}
    </ul>
    {/* на телефоне разделы свёрнуты (открыт раздел текущей страницы), раскрываются нажатием на строку; на компьютере — всё видно */}
    <div class="menu__groups">
      {menu.filter((m) => m.children).map((g, gi) => {
        const link = g.label === T.prices2 && priceOverview ? priceOverview : '';
        const here = g.children.some((c: any) => c.href === page.path) || link === page.path;
        return (
        <section class:list={['menu__sec', here && 'is-open', !link && 'menu__sec--plain']}>
          <h2 class="menu__group">
            {link ? <a href={link}>{g.label}</a> : <span>{g.label}</span>}
            <button type="button" class="menu__tog" aria-expanded={here ? 'true' : 'false'} aria-controls={`menu-g${gi}`} aria-label={g.label}></button>
          </h2>
          <ul id={`menu-g${gi}`}>
            {g.children.map((c: any) => (
              <li><a href={c.href} aria-current={c.href === page.path ? 'page' : undefined}>{c.label}</a></li>
            ))}
          </ul>
        </section>
        );
      })}
    </div>
    <div class="menu__foot">
      <p>
        {menuPhones.map((p: any) => (
          <span class="menu__phone"><a href={`tel:${p.tel}`}>{p.text}</a> <span class="muted">{p.city[lang]}</span></span>
        ))}
      </p>
      <p><a href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a></p>
    </div>
  </nav>
</div>

<script>
  const menu = document.getElementById('menu')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = menu.querySelector<HTMLButtonElement>('[data-menu-close]')!;
  function open() {
    menu.hidden = false;
    document.documentElement.classList.add('menu-open');
    openBtn.setAttribute('aria-expanded', 'true');
    closeBtn.focus();
  }
  function close() {
    menu.hidden = true;
    document.documentElement.classList.remove('menu-open');
    openBtn.setAttribute('aria-expanded', 'false');
    openBtn.focus();
  }
  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  menu.dataset.acc = '';
  menu.querySelectorAll<HTMLButtonElement>('.menu__tog').forEach((b) => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(on));
    b.closest('.menu__sec')?.classList.toggle('is-open', on);
  }));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) close(); });
</script>

<style>
  .hdr, .menu__top {
    position: sticky; top: 0; z-index: 20;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    height: var(--header); padding-inline: var(--pad);
    background: var(--paper);
  }
  .hdr { border-bottom: 1px solid transparent; }
  .hdr__burger {
    justify-self: start; display: inline-flex; align-items: center; gap: 12px;
    min-height: 44px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--ink);
  }
  .hdr__burger-label { font-size: 13px; letter-spacing: 0.06em; }
  @media (max-width: 719px) { .hdr__burger-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
  .hdr__burger { min-width: 44px; }
  .burger { position: relative; width: 26px; height: 12px; }
  .burger i { position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; }
  .burger i:first-child { top: 0; } .burger i:last-child { bottom: 0; }
  .burger--x i:first-child { top: 5px; transform: rotate(45deg); }
  .burger--x i:last-child { bottom: 5px; transform: rotate(-45deg); }

  .hdr__logo { display: block; line-height: 0; }
  .hdr__logo img { display: block; height: 26px; width: auto; }
  @media (min-width: 720px) { .hdr__logo img { height: 34px; } }
  .hdr__right { justify-self: end; display: flex; align-items: center; gap: 20px; }
  .hdr__langs { display: none; gap: 2px; font-size: 13px; letter-spacing: 0.06em; }
  .hdr__langs > * { display: inline-grid; place-items: center; min-width: 32px; min-height: 44px; }
  .hdr__langs a { color: var(--stone); text-decoration: none; }
  .hdr__langs a:hover { color: var(--ink); }
  .hdr__langs [aria-current] { color: var(--ink); }
  @media (min-width: 720px) { .hdr__langs { display: flex; } }
  .hdr__phone { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 44px; height: 44px; margin-right: -12px; padding-right: 12px; color: var(--ink); text-decoration: none; }
  .hdr__phone svg { flex: none; }
  .hdr__phone-text { display: none; font-size: 14px; letter-spacing: 0.04em; white-space: nowrap; }
  @media (min-width: 1100px) { .hdr__phone-text { display: inline; } .hdr__phone { flex-direction: row-reverse; } }

  .menu { position: fixed; inset: 0; z-index: 50; overflow-y: auto; background: var(--paper); }
  .menu__body { padding: clamp(24px, 5vw, 64px) var(--pad) 48px; display: grid; gap: 40px; }
  @media (min-width: 960px) { .menu__body { grid-template-columns: 1fr 2fr; column-gap: 64px; } }
  .menu__main { list-style: none; margin: -7px 0; padding: 0; display: grid; gap: 0; align-content: start; }
  .menu__main a { display: inline-block; padding-block: 7px; text-decoration: none; font-size: clamp(18px, 2.4vw, 26px); }
  .menu__main a[aria-current] { color: var(--oak); }
  .menu__groups { display: grid; gap: 32px; }
  @media (min-width: 720px) { .menu__groups { grid-template-columns: repeat(2, 1fr); gap: 32px; } }
  @media (min-width: 1100px) { .menu__groups { grid-template-columns: repeat(4, 1fr); } }
  .menu__group { font-family: var(--display); text-transform: uppercase; letter-spacing: 0.18em; font-size: 13px; margin-bottom: 12px; color: var(--ink); }
  .menu__group { display: flex; align-items: center; justify-content: space-between; gap: 8px; position: relative; }
  .menu__group a { display: inline-block; padding-block: 4px; margin-block: -4px; text-decoration: none; }
  .menu__tog { display: none; }
  .menu__groups ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  /* телефон: разделы — строки с линией; нажатие на строку (или на стрелку у «Цен» со ссылкой) раскрывает список */
  @media (max-width: 719px) {
    .menu__groups { gap: 0; border-top: 1px solid var(--line); }
    .menu__sec { border-bottom: 1px solid var(--line); }
    .menu__group { margin: 0; min-height: 52px; }
    .menu__group a { flex: 1; padding-block: 16px; margin-block: 0; }
    .menu__tog { display: inline-grid; place-items: center; width: 44px; height: 44px; margin-right: -12px; padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer; }
    .menu__sec--plain .menu__tog::after { content: ''; position: absolute; inset: 0; }
    .menu__tog::before { content: ''; width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform .2s; }
    .menu__tog[aria-expanded='true']::before { transform: translateY(2px) rotate(-135deg); }
    .menu__groups ul { padding-bottom: 12px; }
    .menu[data-acc] .menu__sec:not(.is-open) > ul { display: none; }
    .menu__foot { border-top: 0; padding-top: 0; }   /* разделы уже закончились линией */
  }
  .menu__groups li a { display: inline-block; padding-block: 6px; }
  .menu__groups a { text-decoration: none; }
  .menu__groups a[aria-current] { color: var(--oak); }
  .menu__foot { font-size: 15px; border-top: 1px solid var(--line); padding-top: 24px; display: grid; gap: 8px; }
  @media (min-width: 960px) { .menu__foot { grid-column: 1 / -1; } }
  .menu__foot p { margin: 0; }
  .menu__phone { display: inline-block; margin-right: 24px; }
  .menu__langs { display: flex; gap: 4px; letter-spacing: 0.06em; margin: 0; }
  .menu__langs > * { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; }
  .menu__langs a { color: var(--stone); text-decoration: none; }
  .menu__langs [aria-current] { color: var(--ink); border-bottom: 1px solid var(--ink); }
  .menu__langs--top { margin: -12px 0 -16px -10px; }
  @media (min-width: 960px) { .menu__langs--top { grid-column: 1 / -1; } }
  .menu__phone a, .menu__foot p > a { display: inline-block; padding-block: 8px; }
  :global(html.menu-open) { overflow: hidden; }
</style>
