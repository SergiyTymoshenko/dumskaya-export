---
// Видео с YouTube без сторонних запросов до нажатия: превью — фото проекта с кнопкой «Смотреть видео».
// По нажатию на месте превью открывается плеер youtube-nocookie.com; без JavaScript ссылка ведёт на YouTube.
import Img from './Img.astro';
import { ui, type Lang } from '../lib/i18n';
interface Props { id: string; title: string; poster?: string | null; lang: Lang; class?: string }
const { id, title, poster, lang, class: cls } = Astro.props;
const T = ui(lang);
---
<div class:list={['vid', cls]}>
  <a class="vid__btn" href={`https://www.youtube.com/watch?v=${id}`} data-yt={id} data-title={title}
     target="_blank" rel="noopener" aria-label={`${T.video}: ${title}`}>
    {poster ? <Img id={poster} alt="" sizes="(min-width: 960px) 60vw, 100vw" class="vid__img" /> : <span class="vid__img vid__img--none" />}
    <span class="vid__play" aria-hidden="true">
      <svg viewBox="0 0 64 64" width="64" height="64"><circle cx="32" cy="32" r="31" fill="rgba(0,0,0,.55)" stroke="#fff" stroke-width="1.5"/><path d="M26 21v22l18-11z" fill="#fff"/></svg>
    </span>
    <span class="vid__note">{T.videoNote}</span>
  </a>
</div>
<script>
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-yt]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0&playsinline=1`;
    f.title = a.dataset.title || 'YouTube';
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    f.allowFullscreen = true;
    f.referrerPolicy = 'strict-origin-when-cross-origin';
    f.className = 'vid__frame';
    a.replaceWith(f);
  });
</script>
<style>
  .vid { position: relative; aspect-ratio: 16 / 9; background: #111; overflow: hidden; }
  .vid__btn { position: absolute; inset: 0; display: block; color: #fff; text-decoration: none; }
  .vid__btn :global(.vid__img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .vid__img--none { background: #222; }
  .vid__btn::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,.18); transition: background .3s; }
  .vid__btn:hover::after, .vid__btn:focus-visible::after { background: rgba(0,0,0,.3); }
  .vid__btn:hover :global(.vid__img) { transform: scale(1.02); }
  .vid__play { position: absolute; z-index: 1; left: 50%; top: 50%; transform: translate(-50%, -50%); width: clamp(56px, 7vw, 76px); }
  .vid__play svg { width: 100%; height: auto; display: block; }
  .vid__note { position: absolute; z-index: 1; left: 16px; bottom: 12px; font-size: 13px; letter-spacing: .04em; text-shadow: 0 1px 8px rgba(0,0,0,.5); }
  .vid :global(.vid__frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
