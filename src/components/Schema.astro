---
// Разметка schema.org (JSON-LD): студия, сайт, хлебные крошки, статьи, фото проектов.
import { site, manifest, crumbsFor, allGalleryImages, localize, type Page } from '../lib/data';
import { HREFLANG } from '../lib/i18n';
import home from '../../content/home.json';
interface Props { page: Page }
const { page } = Astro.props;
const SITE = 'https://dumskaya-design.com';
const abs = (p: string) => SITE + (p === '/' ? '/' : p);
const img = (id?: string | null) => {
  const m = id ? manifest[id] : null;
  return m ? `${SITE}/img/${m.files[m.files.length - 1][1]}` : undefined;
};
const c = site.contacts;
const ORG_ID = `${SITE}/#studio`;
const studio = {
  '@type': 'ProfessionalService',
  '@id': ORG_ID,
  name: 'DUMSKAYA DESIGN',
  description: 'Interior design studio: residential and commercial interiors, custom furniture and turnkey renovation in Bratislava and Vienna.',
  url: `${SITE}/`,
  logo: `${SITE}/logo.png`,
  image: img(home.hero),
  email: c.email,
  telephone: c.phones[0].tel,
  priceRange: '€€',
  address: { '@type': 'PostalAddress', streetAddress: c.address.street, postalCode: c.address.postal, addressLocality: c.address.city, addressCountry: c.address.country },
  areaServed: [{ '@type': 'City', name: 'Bratislava' }, { '@type': 'City', name: 'Vienna' }, { '@type': 'Country', name: 'Ukraine' }, { '@type': 'Country', name: 'United States' }],
  contactPoint: c.phones.map((p: any) => ({ '@type': 'ContactPoint', telephone: p.tel, contactType: 'customer service', areaServed: p.city.en, availableLanguage: ['ru', 'uk', 'en'] })),
  sameAs: [...c.social.map((s: any) => s.href), ...(c.maps ? [c.maps] : [])],
  hasMap: c.maps || undefined,
  founder: { '@type': 'Person', name: 'Irina Dumskaya' },
};
const graph: any[] = [];
if (page.type === 'home' || page.type === 'contact') {
  graph.push(studio);
  if (page.type === 'home') graph.push({ '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'DUMSKAYA DESIGN', inLanguage: ['ru', 'uk', 'en'], publisher: { '@id': ORG_ID } });
} else {
  graph.push({ '@type': 'Organization', '@id': ORG_ID, name: 'DUMSKAYA DESIGN', url: `${SITE}/`, logo: `${SITE}/logo.png` });
}
const crumbs = crumbsFor(page);
if (crumbs.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    // Google требует ссылку (item) у каждого звена, кроме последнего: звенья-подписи без своей страницы
    // («Услуги», «Советы», «Где мы работаем») в разметку не попадают
    itemListElement: crumbs
      .filter((cr, i) => cr.href || i === crumbs.length - 1)
      .map((cr, i) => ({ '@type': 'ListItem', position: i + 1, name: cr.label, ...(cr.href ? { item: abs(cr.href) } : {}) })),
  });
}
const images = allGalleryImages(page).filter((i) => manifest[i.id]);
if (page.type === 'article') {
  graph.push({
    '@type': 'Article', headline: page.h1, description: page.description, inLanguage: HREFLANG[page.lang],
    mainEntityOfPage: abs(page.path), image: images.slice(0, 5).map((i) => img(i.id)),
    author: { '@id': ORG_ID }, publisher: { '@id': ORG_ID },
  });
}
if (page.type === 'project' || page.type === 'kitchen') {
  graph.push({
    '@type': 'CreativeWork', name: page.h1, description: page.description, inLanguage: HREFLANG[page.lang], url: abs(page.path),
    creator: { '@id': ORG_ID },
    image: images.slice(0, 12).map((i) => ({
      '@type': 'ImageObject', contentUrl: img(i.id), caption: i.alt,
      // права на фото и визуализации — у Iryna Dumska (основательница студии)
      creator: { '@type': 'Person', name: 'Iryna Dumska' }, creditText: 'Iryna Dumska / DUMSKAYA DESIGN',
      copyrightNotice: '© Iryna Dumska', copyrightHolder: { '@type': 'Person', name: 'Iryna Dumska' },
      license: abs(localize('/image-license', page.lang as any) || '/image-license'),
      acquireLicensePage: abs(localize('/contact-studio-interior-design-bratislava-vienna', page.lang as any) || '/contact-studio-interior-design-bratislava-vienna'),
    })),
  });
}
const faq = page.sections.flatMap((s) => s.blocks).filter((b: any) => b.type === 'faq').flatMap((b: any) => b.items);
if (faq.length) {
  const txt = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f: any) => ({ '@type': 'Question', name: txt(f.q), acceptedAnswer: { '@type': 'Answer', text: txt(f.a) } })),
  });
}
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
