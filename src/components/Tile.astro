---
import Img from './Img.astro';
import Caps from './Caps.astro';
interface Props {
  href: string | null;
  image: string | null | undefined;
  alt?: string;
  title: string;
  sub?: string;
  sizes?: string;
  eager?: boolean;
  /** подпись под фото, а не поверх (для светлых предметных снимков) */
  below?: boolean;
}
const { href, image, alt = '', title, sub, sizes = '(min-width: 720px) 50vw, 100vw', eager = false, below = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['tile', below && 'tile--below']} href={href || undefined}>
  {/* подпись под фото и так называет ссылку: alt, равный подписи, читался бы дважды — тогда alt пустой */}
  <Img id={image} alt={alt && alt !== title ? alt : ''} sizes={sizes} eager={eager} />
  <span class="tile__cap">
    <span class="tile__title"><Caps text={title} /></span>
    {sub && <span class="tile__sub" style="display:block">{sub}</span>}
  </span>
</Tag>
