---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Lightbox from '../components/Lightbox.astro';
import { HREFLANG, HTML_LANG, OG_LOCALE, LANGS, ui, type Lang } from '../lib/i18n';
// основные начертания кириллицы — грузятся заранее, чтобы заголовки не «прыгали» при подмене шрифта
import fontDisplayCyr from '@fontsource/montserrat/files/montserrat-cyrillic-400-normal.woff2?url';
import fontBodyCyr from '@fontsource/commissioner/files/commissioner-cyrillic-400-normal.woff2?url';
import fontDisplayLat from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import fontBodyLat from '@fontsource/commissioner/files/commissioner-latin-400-normal.woff2?url';
import { site, manifest, firstGallery, type Page } from '../lib/data';
import home from '../../content/home.json';

interface Props { page: Page; noindex?: boolean }
const { page, noindex = false } = Astro.props;
const lang = page.lang as Lang;
const SITE = 'https://dumskaya-design.com';
const url = (p: string) => SITE + (p === '/' ? '/' : p);
const xDefault = page.alternates.en || page.alternates.ru || page.path;
const ogId = [page.type === 'home' ? home.hero : null, page.og_image, firstGallery(page)[0]?.id, home.hero].find((id) => id && manifest[id]);
const og = ogId ? manifest[ogId] : null;
const ogUrl = og ? `${SITE}/img/${(og.files.find(([w]) => w >= 1200) || og.files[og.files.length - 1])[1]}` : undefined;
const analytics = import.meta.env.PUBLIC_ANALYTICS === '1';
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {(['en', 'sk', 'de'].includes(lang) ? [fontDisplayLat, fontBodyLat] : [fontDisplayCyr, fontBodyCyr]).map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
  <title>{page.title}</title>
  {page.description && <meta name="description" content={page.description} />}
  {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={url(page.path)} />}
  {!noindex && LANGS.filter((l) => page.alternates[l]).map((l) => (
    <link rel="alternate" hreflang={HREFLANG[l]} href={url(page.alternates[l]!)} />
  ))}
  {!noindex && <link rel="alternate" hreflang="x-default" href={url(xDefault)} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="DUMSKAYA DESIGN" />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  {!noindex && LANGS.filter((l) => l !== lang && page.alternates[l]).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
  <meta property="og:title" content={page.title} />
  {page.description && <meta property="og:description" content={page.description} />}
  <meta property="og:url" content={url(page.path)} />
  {ogUrl && <meta property="og:image" content={ogUrl} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="google-site-verification" content={site.verification.google} />
  <meta name="yandex-verification" content={site.verification.yandex} />
  {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" sizes="96x96" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" />
  {!noindex && <Schema page={page} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">{ui(lang).skip}</a>
  <Header page={page} />
  <main id="main">
    <slot />
  </main>
  <Footer page={page} />
  <Lightbox lang={lang} />
  {analytics && <CookieBanner lang={lang} gtm={site.analytics.gtm} ga4={site.analytics.ga4} />}
  <script is:inline>
    // Нажатия на телефон, e-mail и мессенджеры — в статистику студии: только что нажали и на какой странице, без cookie
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]'); if (!a) return;
      var h = a.getAttribute('href') || '';
      var t = /^tel:/i.test(h) ? 'tel' : /^mailto:/i.test(h) ? 'mail' : /\/\/wa\.me\//i.test(h) ? 'whatsapp' : /\/\/t\.me\//i.test(h) ? 'telegram' : '';
      if (!t) return;
      try { navigator.sendBeacon('/api/hit', new Blob([JSON.stringify({ t: t, p: location.pathname })], { type: 'text/plain' })); } catch (err) {}
      if (window.gtag) window.gtag('event', 'contact_click', { method: t });   // Google Analytics — если принят cookie
    }, true);
  </script>
</body>
</html>
